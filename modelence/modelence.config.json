{
  "$schema": "https://cloud.modelence.com/schema/modelence.config.json?version=1",
  "resources": {
    "web": {
      "type": "service",
      "image": "node-22-slim",
      "build": { "commands": [] },
      "start": { "commands": ["node server.js"] }
    }
  },
  "env": {
    // Where the Python API (FastAPI + local model) is reachable. Override in the dashboard if the tunnel changes.
    "FASTAPI_URL": { "value": "https://power-longest-areas-structural.trycloudflare.com", "required": false }
  }
}
