# Copy to .env and fill in what you use. .env is git-ignored; never commit it.
# Everything runs locally with no keys: a SQLite document store, local embeddings
# through Ollama, and local models. Keys only add optional comparison models.

# Local store
OA_DATA_DIR=./var

# Embeddings: auto (Ollama if reachable, else hashing) | ollama | hash
OA_EMBEDDER=auto
OA_OLLAMA_URL=http://localhost:11434
OA_EMBED_MODEL=hf.co/CompendiumLabs/bge-base-en-v1.5-gguf:latest
OA_EMBED_DIM=768

# Optional external models for comparison (see config/models.yaml)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Meta-agent (improver, judge, cycle analyst): a profile name from config/models.yaml; empty = the default
OA_META_MODEL=

# Structured data: company databases through NVIDIA Auto Ontology (scripts/auto_ontology.sh up)
# auto = use it when it answers on OA_AO_URL; off = never
OA_STRUCTURED=auto
OA_AO_URL=http://localhost:3000
# Per-employee tokens go in var/auto-ontology-tokens.json; this shared token is a development fallback
OA_AO_TOKEN=

# Auth
OA_JWT_SECRET=change-me
