# Copy to .env and fill in. .env is git-ignored; never commit it.

# MongoDB Atlas Hackathon Sandbox connection string (required for finalists)
MONGODB_URI=
MONGODB_DB=omniq_atlas

# Voyage AI embeddings + reranking
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-4
VOYAGE_RERANK_MODEL=rerank-3

# Claude: assistant model and the meta-agent that evolves the harness
ANTHROPIC_API_KEY=
OA_ASSISTANT_MODEL=
OA_META_MODEL=

# Raindrop agent monitoring
RAINDROP_WRITE_KEY=
RAINDROP_QUERY_API_KEY=   # read-scoped key for the Query API (7-day cycle reads signals back)


# Auth
OA_JWT_SECRET=change-me
